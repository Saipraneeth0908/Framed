    l.line_total_cents
from "framedobsessions"."stg_stg"."stg_orders" o
join lines l on l.order_id = o.order_id
where l.line_total_cents <> o.subtotal_cents
   or o.total_cents <> o.subtotal_cents - o.discount_cents + o.shipping_cents + o.tax_cents
  
  
      
    ) dbt_internal_test
