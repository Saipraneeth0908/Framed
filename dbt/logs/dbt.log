    from "framedobsessions"."stg"."stg_order_items"
    group by order_id
)
select
    o.order_id,
    o.total_cents,
    o.subtotal_cents,
    o.discount_cents,
    l.line_total_cents
from "framedobsessions"."stg"."stg_orders" o
join lines l on l.order_id = o.order_id
where l.line_total_cents <> o.subtotal_cents
