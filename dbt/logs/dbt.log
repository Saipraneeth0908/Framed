  create  table "framedobsessions"."mart"."mart_search_demand__dbt_tmp"
  
  
    as
  
  (
    
select
    occurred_at::date          as day,
    lower(props ->> 'term')    as term,
    count(*)                   as searches,
    count(distinct session_id) as sessions,
    sum(case when event_name = 'search_zero_results' then 1 else 0 end) as zero_result_searches
from "framedobsessions"."stg"."stg_events"
