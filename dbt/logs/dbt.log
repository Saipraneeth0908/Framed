  create  table "framedobsessions"."mart"."mart_funnel_daily__dbt_tmp"
  
  
    as
  
  (
    
with __dbt__cte__int_funnel_steps as (
-- One row per session with the furthest step it reached. Funnel steps are
-- monotonic by construction here, which is what makes the singular test
-- assert_funnel_is_monotonic meaningful rather than tautological.
select
    session_key,
    started_at::date as day,
    device,
    utm_source,
    country,
    1                                              as reached_view,
    case when saw_product        then 1 else 0 end as reached_product,
    case when added_to_cart      then 1 else 0 end as reached_cart,
    case when started_checkout   then 1 else 0 end as reached_checkout,
    case when purchased          then 1 else 0 end as reached_purchase
from "framedobsessions"."stg"."stg_sessions"
) select
    day,
    device,
    utm_source,
    count(*)              as sessions,
    sum(reached_product)  as viewed_product,
    sum(reached_cart)     as added_to_cart,
    sum(reached_checkout) as started_checkout,
    sum(reached_purchase) as purchased,
    round(100.0 * sum(reached_purchase) / nullif(count(*), 0), 2) as conversion_pct
from __dbt__cte__int_funnel_steps
group by day, device, utm_source
  );
  
