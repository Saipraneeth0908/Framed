# Copy to deploy/.env for local work. Nothing here is loaded automatically --
# scripts/dev.sh and docker compose read deploy/.env explicitly.

# --- secrets (generate, never reuse across environments) --------------------
# python -c "import secrets;print(secrets.token_urlsafe(48))"
WEB_SECRET_KEY=
ADMIN_SECRET_KEY=
# python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ADMIN_TOTP_KEY=
EVENT_SALT_SEED=

# --- databases (one role per process; that is the isolation boundary) -------
DATABASE_URL=postgres://postgres:postgres@localhost:5433/framedobsessions?sslmode=disable
STORE_DATABASE_URL=postgres://store_app:store_app_dev@localhost:5433/framedobsessions?sslmode=disable
ADMIN_DATABASE_URL=postgres://admin_app:admin_app_dev@localhost:5433/framedobsessions?sslmode=disable
INGEST_DATABASE_URL=postgres://ingest:ingest_dev@localhost:5433/framedobsessions?sslmode=disable
ETL_DATABASE_URL=postgres://etl:etl_dev@localhost:5433/framedobsessions?sslmode=disable
REDIS_URL=redis://localhost:6380/0

# --- local development only -------------------------------------------------
# Cookies are Secure by default; http local development needs this off.
FO_INSECURE_COOKIES=1

# --- optional ---------------------------------------------------------------
# Unset means the storefront renders no analytics beacon at all.
COLLECTOR_URL=http://localhost:8002/e
ALLOWED_ORIGINS=http://localhost:8000
ADMIN_COOKIE_DOMAIN=

# Unset means the stub gateway settles orders immediately (development only).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STORE_BASE_URL=http://localhost:8000

# Unset means the Insights page explains how to connect Metabase instead of
# rendering empty iframes.
METABASE_SITE_URL=
METABASE_EMBED_SECRET=
